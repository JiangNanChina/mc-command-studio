{
  "name": "mc-command-studio",
  "version": "0.7.1",
  "private": true,
  "description": "MC 指令工坊 - 中文优先的 Windows Minecraft Java 命令编辑器（测试阶段，部分功能尚未完成）",
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "postinstall": "node tools/release/ensure-electron.mjs",
    "setup:electron": "node tools/release/ensure-electron.mjs",
    "dev": "pnpm --filter @mcstudio/desktop dev",
    "build": "pnpm --filter @mcstudio/desktop build",
    "build:win": "pnpm data:build && pnpm --filter @mcstudio/desktop build:win",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:build": "node tools/pipeline/build-all.mjs",
    "data:build:1.13": "node tools/pipeline/build-1.13.2.mjs",
    "data:build:1.12": "node tools/pipeline/build-1.12.2.mjs",
    "data:catalog": "node tools/pipeline/build-version-catalog.mjs",
    "data:verify": "node --test tools/pipeline/pack-files.test.mjs && node tools/pipeline/verify-all.mjs && node tools/pipeline/verify-1.13.mjs && node tools/pipeline/verify-catalog.mjs && node tools/pipeline/verify-matrix.mjs && node tools/pipeline/verify-coverage.mjs && node tools/pipeline/verify-quick-matrix.mjs && node tools/pipeline/audit-assets.mjs",
    "check:version": "node tools/release/verify-version.mjs",
    "configure:github": "node tools/release/configure-github.mjs",
    "release:patch": "node tools/release/bump.mjs patch",
    "release:minor": "node tools/release/bump.mjs minor",
    "update:serve": "node tools/release/mock-update-server.mjs",
    "mirror:check": "node tools/release/check-mirror.mjs",
    "oss:setup": "node tools/release/setup-oss.mjs",
    "release:oss": "node tools/release/release-oss.mjs",
    "e2e": "node tools/e2e/smoke.mjs",
    "e2e:update": "node tools/e2e/update-test.mjs",
    "test:e2e:matrix": "node tools/e2e/version-matrix-smoke.mjs",
    "test:e2e:quick": "node tools/e2e/quick-matrix-smoke.mjs",
    "test:build": "node tools/test/build-test.mjs",
    "test:serve": "node tools/release/mock-update-server.mjs release-test 8123",
    "assets:audit": "node tools/pipeline/audit-assets.mjs",
    "test:e2e:all": "node tools/e2e/all-versions-load.mjs",
    "test:e2e:legacy": "node tools/e2e/legacy-groups-smoke.mjs",
    "test:e2e:shots": "node tools/e2e/quick-matrix-shots.mjs",
    "test:e2e:update-ui": "node tools/e2e/update-ui-test.mjs",
    "test:e2e:update-full": "node tools/e2e/update-ui-full-test.mjs",
    "data:migrate": "node tools/pipeline/migrate-pack-metadata.mjs",
    "test:e2e:persistence": "node tools/e2e/persistence-smoke.mjs",
    "test:pipeline": "node --test tools/pipeline/pack-files.test.mjs",
    "check:runtime": "node tools/release/verify-runtime.mjs",
    "test:e2e:updater-bundle": "node tools/e2e/updater-bundle-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
